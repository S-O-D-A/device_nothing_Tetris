cc_library_shared {
    name: "libshim_vtservice",
    srcs: ["libshim_vtservice.cpp"],

    compile_multilib: "64",
    system_ext_specific: true,

    header_libs: [
        "libaudioclient_headers",
        "libmedia_headers",
    ],

    shared_libs: [
        "libaudioclient",
    ],

    cflags: [
        "-Wall",
        "-Werror",
    ],
}
